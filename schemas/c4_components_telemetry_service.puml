@startuml c4_components_telemetry_service
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Компоненты Telemetry Service

Container(api_gateway, "API Gateway", "Kong/Nginx", "Маршрутизация запросов")
Container(message_queue, "Message Queue", "Redis", "Асинхронные события")
ContainerDb(telemetry_db, "InfluxDB", "InfluxDB", "Временные ряды")
ContainerDb(device_state_cache, "Device State Cache", "Redis", "Текущие состояния")

Container_Boundary(telemetry_service, "Telemetry Service") {
    Component(telemetry_api, "Telemetry API", "Gin REST API", "REST эндпоинты для получения данных")
    Component(data_collector, "Data Collector", "Go", "Сбор данных с датчиков")
    Component(data_processor, "Data Processor", "Go", "Обработка и валидация данных")
    Component(analytics_engine, "Analytics Engine", "Go", "Аналитика и агрегация данных")
    Component(alert_detector, "Alert Detector", "Go", "Обнаружение критических значений")
    Component(data_repository, "Data Repository", "Go", "Слой доступа к временным рядам")
    Component(state_updater, "State Updater", "Go", "Обновление текущих состояний")
    Component(event_subscriber, "Event Subscriber", "Go", "Подписка на события устройств")
}

System_Ext(sensors, "IoT Датчики", "Температура, влажность, движение")

Rel(api_gateway, telemetry_api, "HTTP запросы данных", "REST/JSON")

Rel(sensors, data_collector, "Данные датчиков", "HTTP/MQTT")

Rel(telemetry_api, analytics_engine, "Запросы аналитики", "Go interface")
Rel(telemetry_api, data_repository, "Запросы исторических данных", "Go interface")

Rel(data_collector, data_processor, "Сырые данные", "Go interface")
Rel(data_processor, data_repository, "Обработанные данные", "Go interface")
Rel(data_processor, state_updater, "Обновление состояния", "Go interface")
Rel(data_processor, alert_detector, "Данные для анализа", "Go interface")

Rel(analytics_engine, data_repository, "Запросы для аналитики", "Go interface")
Rel(alert_detector, message_queue, "Критические алерты", "Redis pub/sub")

Rel(event_subscriber, message_queue, "События устройств", "Redis pub/sub")
Rel(event_subscriber, data_processor, "Контекст устройств", "Go interface")

Rel(data_repository, telemetry_db, "Запросы временных рядов", "InfluxQL")
Rel(state_updater, device_state_cache, "Обновление текущих состояний", "Redis SET")

SHOW_LEGEND()
@enduml